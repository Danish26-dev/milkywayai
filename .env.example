# =============================================================================
# MilkyWay — Environment Variable NAMES ONLY. Never put real secret values here.
# This file is committed. Copy to `.env` for LOCAL development.
#
# Gemini AUTHENTICATION uses Vertex AI + Application Default Credentials (ADC).
# There is NO Gemini API key in production and NO service-account JSON anywhere.
# =============================================================================

# -----------------------------------------------------------------------------
# GCP PROJECT / VERTEX AI (used in production AND recommended locally)
# -----------------------------------------------------------------------------

# GOOGLE_CLOUD_PROJECT: GCP project id. On Cloud Run this is provided automatically.
# Defaults to milkyway-507714 if unset (see geminiAuth.ts).
GOOGLE_CLOUD_PROJECT=milkyway-507714

# GEMINI_LOCATION: Vertex AI region for the Gemini model (e.g. us-central1, global).
GEMINI_LOCATION=us-central1

# GEMINI_MODEL: Single canonical Gemini model name used by the investigation agent.
# Must be a model available on Vertex AI in the chosen location.
GEMINI_MODEL=gemini-2.5-flash

# NODE_ENV: "development" locally, "production" on Cloud Run.
NODE_ENV=development

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT — AUTH CHOICE
# -----------------------------------------------------------------------------
# By default local dev also uses Vertex AI + ADC (run `gcloud auth application-default login`).
#
# GEMINI_USE_VERTEX (optional): set "true" to force Vertex AI locally (matches prod).
GEMINI_USE_VERTEX=true

# GEMINI_API_KEY (OPTIONAL, LOCAL DEV ONLY): if you prefer the Gemini Developer API
# locally instead of Vertex AI, set a key here AND leave GEMINI_USE_VERTEX unset/false.
# PRODUCTION NEVER USES THIS. Leave blank to use Vertex AI + ADC.
GEMINI_API_KEY=

# ENABLE_DEV_AUTH (LOCAL ONLY): when "true" AND NODE_ENV != "production", the server
# accepts the dev bearer tokens "dev-officer" / "dev-admin". Production always rejects them.
ENABLE_DEV_AUTH=false

# BIGQUERY_PROJECT_ID (optional): when set, the backend connects to live BigQuery;
# otherwise it uses the in-memory deterministic journal.
BIGQUERY_PROJECT_ID=

# -----------------------------------------------------------------------------
# CREDENTIALS
# -----------------------------------------------------------------------------
# There is NO GOOGLE_APPLICATION_CREDENTIALS / service-account JSON key.
# Authentication uses Application Default Credentials:
#   - Cloud Run: the attached runtime service account (milkyway-run@milkyway-507714.iam.gserviceaccount.com).
#   - Local:     `gcloud auth application-default login` + `gcloud config set project milkyway-507714`.
#
# Secret Manager remains available for GENUINE future secrets (see secretProvider.ts),
# but is NOT used to store a Gemini API key.
