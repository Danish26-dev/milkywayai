rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role comes ONLY from the verified custom claim on the ID token.
    // It is never read from a client-writable document, preventing self-escalation.
    function claimRole() {
      return isAuthenticated() ? request.auth.token.role : '';
    }

    function isAdmin() {
      return claimRole() == 'ADMIN';
    }

    function isOfficer() {
      return claimRole() == 'OFFICER' || isAdmin();
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // A user may read their own profile; ADMIN may read all.
    // A user may NOT create/alter role, uid, or other authorization fields.
    // Role changes happen ONLY via the Admin SDK backend (which bypasses rules).
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // On self-create, the user cannot grant themselves a privileged role.
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'OFFICER')
        && request.resource.data.uid == userId;

      // On self-update, role and uid must be UNCHANGED. ADMIN role management is
      // performed server-side with the Admin SDK (not through client updates).
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false; // never delete users from the client
    }

    // ---------------------------------------------------------------------
    // cases/{caseId}
    // Officer can read/update cases assigned to them or shared with them; ADMIN all.
    // An officer can NEVER reassign a case to another officer (assignedOfficerUid
    // must remain unchanged on officer updates). Only ADMIN may reassign.
    // On create, the assignedOfficerUid MUST equal the creator (or creator is ADMIN).
    // ---------------------------------------------------------------------
    match /cases/{caseId} {
      function assigned() { return resource.data.assignedOfficerUid; }
      function sharedList() {
        return ('sharedWithUids' in resource.data) ? resource.data.sharedWithUids : [];
      }
      function canReadCase() {
        return isAdmin()
          || (isOfficer() && (assigned() == request.auth.uid || request.auth.uid in sharedList()));
      }

      allow read: if canReadCase();

      allow create: if isOfficer()
        && (isAdmin() || request.resource.data.assignedOfficerUid == request.auth.uid);

      // Officer updates must keep ownership stable (no hijack, no self-reassign to others).
      allow update: if isAdmin()
        || (isOfficer()
            && (assigned() == request.auth.uid || request.auth.uid in sharedList())
            && request.resource.data.assignedOfficerUid == resource.data.assignedOfficerUid);

      allow delete: if isAdmin();

      // Legacy embedded subcollections (kept read-restricted to authorized case viewers).
      match /notes/{noteId} {
        allow read: if isAdmin()
          || (isOfficer() && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedOfficerUid == request.auth.uid);
        allow create: if isOfficer() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /chat/{msgId} {
        allow read: if isAdmin()
          || (isOfficer() && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedOfficerUid == request.auth.uid);
        allow write: if false; // chat is written server-side via Admin SDK
      }
    }

    // ---------------------------------------------------------------------
    // officer_notes/{noteId}
    // A note is private to its author (and the case's assigned officer / ADMIN).
    // authorUid must equal the creator; notes are immutable from the client.
    // ---------------------------------------------------------------------
    match /officer_notes/{noteId} {
      allow read: if isAdmin()
        || (isOfficer() && resource.data.authorUid == request.auth.uid);
      allow create: if isOfficer() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOfficer()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // chat_summaries/{summaryId}
    // Owned by the officer who created it (officerUid). Only that officer or ADMIN
    // may read; officerUid is immutable and must match the creator.
    // ---------------------------------------------------------------------
    match /chat_summaries/{summaryId} {
      allow read: if isAdmin()
        || (isOfficer() && resource.data.officerUid == request.auth.uid);
      allow create: if isOfficer() && request.resource.data.officerUid == request.auth.uid;
      allow update: if isOfficer()
        && resource.data.officerUid == request.auth.uid
        && request.resource.data.officerUid == resource.data.officerUid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // alerts/{alertId}
    // Officer sees alerts assigned to them; ADMIN sees all.
    // assignedOfficerUid is immutable on officer updates.
    // ---------------------------------------------------------------------
    match /alerts/{alertId} {
      allow read: if isAdmin()
        || (isOfficer() && resource.data.assignedOfficerUid == request.auth.uid);
      allow create: if isOfficer()
        && (isAdmin() || request.resource.data.assignedOfficerUid == request.auth.uid);
      allow update: if isAdmin()
        || (isOfficer()
            && resource.data.assignedOfficerUid == request.auth.uid
            && request.resource.data.assignedOfficerUid == resource.data.assignedOfficerUid);
      allow delete: if isAdmin();
    }
  }
}
