rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('ADMIN') || hasRole('admin');
    }

    function isOfficer() {
      return hasRole('OFFICER') || hasRole('officer') || isAdmin();
    }

    // users/{uid} collection
    // User can read their own profile; Admin can read all; Users can update their own lastLoginAt or basic profile
    // Role field can ONLY be modified by Admins
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Officer private application data & dossiers
    // An officer cannot access another officer's private case data unless assigned or an Admin
    match /cases/{caseId} {
      allow read: if isOfficer() && (
        resource.data.assignedOfficerId == request.auth.uid ||
        resource.data.assignedOfficerBadge == getUserData().badgeNumber ||
        isAdmin()
      );
      allow create: if isOfficer();
      allow update: if isOfficer() && (
        resource.data.assignedOfficerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Append-only officer notes subcollection
      match /notes/{noteId} {
        allow read: if isOfficer();
        allow create: if isOfficer() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false; // Append-only integrity: notes cannot be mutated or deleted
      }
    }

    // Supply-chain batches and facilities (read-only for authenticated officers and admins)
    match /batches/{batchId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /facilities/{facilityId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isOfficer();
      allow write: if isOfficer();
    }
  }
}
