rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('ADMIN') || hasRole('admin');
    }

    function isOfficer() {
      return hasRole('OFFICER') || hasRole('officer') || isAdmin();
    }

    // 1. users collection
    // User can read their own profile; Admin can read all; Role field can ONLY be modified by Admins
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. cases/{caseId}
    // An officer may access:
    // - Their assigned cases (assignedOfficerUid == request.auth.uid)
    // - Cases explicitly shared with them (sharedWithUids contains request.auth.uid)
    // An admin may access according to admin policy.
    // Never trust frontend-supplied officerUid; authenticated UID is enforced.
    match /cases/{caseId} {
      allow read: if isOfficer() && (
        resource.data.assignedOfficerUid == request.auth.uid ||
        (resource.data.sharedWithUids != null && request.auth.uid in resource.data.sharedWithUids) ||
        isAdmin()
      );
      allow create: if isOfficer() && (
        request.resource.data.assignedOfficerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isOfficer() && (
        resource.data.assignedOfficerUid == request.auth.uid ||
        (resource.data.sharedWithUids != null && request.auth.uid in resource.data.sharedWithUids) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Legacy subcollection support for backwards compatibility
      match /notes/{noteId} {
        allow read: if isOfficer();
        allow create: if isOfficer() && request.resource.data.officerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 3. officer_notes/{noteId}
    // Top-level collection storing: noteId, caseId, officerUid, content, createdAt
    match /officer_notes/{noteId} {
      allow read: if isOfficer();
      allow create: if isOfficer() && request.resource.data.officerUid == request.auth.uid;
      allow update: if isOfficer() && resource.data.officerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 4. chat_summaries/{caseId}
    // Stores concise investigation conversation summaries rather than raw token floods
    match /chat_summaries/{caseId} {
      allow read: if isOfficer();
      allow write: if isOfficer();
    }

    // 5. alerts/{alertId}
    // Persists detected anomalies as application alerts:
    // alertId, batchId, anomalyId, severity, facilityId, status, createdAt
    match /alerts/{alertId} {
      allow read: if isOfficer();
      allow create: if isOfficer();
      allow update: if isOfficer();
      allow delete: if isAdmin();
    }
  }
}
